{
  "name": "__starter__",
  "version": "1.0.0",
  "description": "A WordPress theme using Tailwind CSS 4",
  "scripts": {
    "preview": "npm-run-all --parallel wpstart tailwindwatch sync",
    "start": "npm-run-all --parallel wpstart tailwindwatch",
    "build": "npm-run-all --sequential buildwp tailwindbuild",
    "wpstart": "wp-scripts start assets/js/src/index.js --output-path=assets/js/dist",
    "buildwp": "wp-scripts build assets/js/src/index.js --output-path=assets/js/dist",
    "tailwindwatch": "npx @tailwindcss/cli -i assets/css/src/tailwindcss/main.css -o assets/css/dist/main.css --watch",
    "tailwindbuild": "npx @tailwindcss/cli -i assets/css/src/tailwindcss/main.css -o assets/css/dist/main.css --minify",
    "sync": "browser-sync start --proxy '__STARTER_DOMAIN__' --files '**/*.php, assets/css/dist/*.css, assets/js/dist/*.js'"
  },
  "devDependencies": {
    "@wordpress/scripts": "^31.7.0",
    "@tailwindcss/cli": "^4.1.5",
    "@tailwindcss/typography": "^0.5.16",
    "tailwindcss": "^4.1.5",
    "browser-sync": "^3.0.4",
    "npm-run-all": "^4.1.5"
  }
}
