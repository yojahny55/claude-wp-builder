# =============================================================================
# Copia este archivo a .env y rellena SOLO lo necesario.
#   cp .env.example .env
# El archivo .env NUNCA debe subirse al repositorio (ya esta en .gitignore).
# =============================================================================

# URL base del sitio a auditar (sobrescribe la de audit.config.js si se define)
BASE_URL=https://example.com

# Tipo de autenticacion del sitio:
#   none  -> el sitio es publico, no requiere login
#   basic -> autenticacion HTTP Basic (ventana del navegador usuario/contrasena)
#   form  -> formulario de login (usuario/contrasena en una pagina /login)
AUTH_TYPE=none

# Credenciales de acceso (necesarias si AUTH_TYPE es basic o form).
# Dejalas vacias si AUTH_TYPE=none.
SITE_USERNAME=
SITE_PASSWORD=

# --- Suite de regresion de flujos de comprador (npm run test:regression) ---
# Solo por entorno, nunca en audit.config.js. Todas son opcionales: sin ellas el flujo
# correspondiente sale SKIP.
# Ruta de un Chromium que YA exista (no se instala ninguno desde aqui).
CHROMIUM_PATH=
# Etiqueta de la ejecucion: before / after para compararlas despues.
REGRESSION_LABEL=
# Administrador del CLON para el humo del admin (nunca el de produccion).
REGRESSION_ADMIN_USER=
REGRESSION_ADMIN_PASS=
# Cuenta de cliente de prueba para comprobar el acceso real a Mi cuenta.
REGRESSION_CUSTOMER_USER=
REGRESSION_CUSTOMER_PASS=
