# =============================================================================
# Copia este archivo a .env y rellena SOLO lo necesario.
#   cp .env.example .env
# El archivo .env NUNCA debe subirse al repositorio (ya esta en .gitignore).
# =============================================================================

# URL base del sitio a auditar (sobrescribe la de audit.config.js si se define)
BASE_URL=https://example.com

# Tipo de autenticacion del sitio:
#   none  -> el sitio es publico, no requiere login
#   basic -> autenticacion HTTP Basic (ventana del navegador usuario/contrasena)
#   form  -> formulario de login (usuario/contrasena en una pagina /login)
AUTH_TYPE=none

# Credenciales de acceso (necesarias si AUTH_TYPE es basic o form).
# Dejalas vacias si AUTH_TYPE=none.
SITE_USERNAME=
SITE_PASSWORD=
