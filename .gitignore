# Internal design docs (specs and plans are working documents, not shipped)
docs/superpowers/

# OS files
.DS_Store
Thumbs.db

# Editor files
*.swp
*.swo
*~
.vscode/
.idea/

# Node (if Tailwind or build tools are added later)
node_modules/
package-lock.json

# WordPress test sites (generated by /wp-create)
.wp-create.json
# ...except the committed fixtures under tests/fixtures/manifests/, which are
# intentionally tracked. Scoped by glob (not one negation line per fixture) so a
# fixture added later in this plan doesn't silently vanish from `git status` again.
!tests/fixtures/manifests/**/.wp-create.json

# Claude Code local settings
.claude/settings.local.json

# Serena MCP workspace cache (per-machine index, not shared state)
.serena/

# Codebase-memory MCP artifacts — local index, never committed.
.codebase-memory/
